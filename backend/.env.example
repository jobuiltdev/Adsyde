ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Adsyde <no-reply@localhost>
FRONTEND_BASE_URL=http://localhost:3000
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7
EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400
PASSWORD_RESET_TIMEOUT_SECONDS=3600
THROTTLE_AUTH_REGISTER_RATE=5/min
THROTTLE_AUTH_LOGIN_RATE=5/min
THROTTLE_AUTH_VERIFY_RATE=10/hour
THROTTLE_AUTH_VERIFICATION_RESEND_RATE=3/hour
THROTTLE_AUTH_REFRESH_RATE=20/min
THROTTLE_AUTH_PASSWORD_RESET_RATE=5/hour
THROTTLE_AUTH_PASSWORD_RESET_CONFIRM_RATE=10/hour
THROTTLE_AUTH_LOGOUT_RATE=20/hour
THROTTLE_ACCOUNT_UPDATE_RATE=20/hour
ASSET_MAX_FILE_SIZE=10485760
ASSET_MAX_DIMENSION=8192
ASSET_MAX_PIXELS=40000000
ASSET_MAX_PER_PROJECT=30
DATA_UPLOAD_MAX_MEMORY_SIZE=11534336
REQUEST_MAX_BODY_SIZE=11534336
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
THROTTLE_PROJECT_CREATE_RATE=20/hour
THROTTLE_PROJECT_MUTATION_RATE=60/hour
THROTTLE_ASSET_UPLOAD_RATE=30/hour
THROTTLE_ASSET_DELETE_RATE=60/hour
THROTTLE_ASSET_ACCESS_RATE=120/hour
CELERY_BROKER_URL=redis://localhost:6379/0
GENERATION_MAX_ACTIVE_PER_USER=5
GENERATION_MAX_PROMPT_LENGTH=4000
GENERATION_MIN_DURATION_SECONDS=5
